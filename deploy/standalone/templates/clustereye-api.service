[Unit]
Description=ClusterEye Monitoring Platform API
Documentation=https://github.com/CloudNativeWorks/clustereye-api
After=network-online.target postgresql.service influxdb.service
Wants=network-online.target

[Service]
Type=simple
User=clustereye
Group=clustereye
EnvironmentFile=/etc/clustereye/secrets.env
ExecStart=/usr/local/bin/clustereye-api
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
WorkingDirectory=/var/lib/clustereye

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/clustereye /var/log/clustereye /etc/clustereye
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictNamespaces=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

StandardOutput=journal
StandardError=journal
SyslogIdentifier=clustereye-api
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
